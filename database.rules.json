{
  "rules": {
    ".read": false,
    ".write": false,

    "userRoles": {
      ".read": false,
      ".write": false
    },

    "creativeStudio": {
      ".read": false,
      ".write": false
    },

    "clientPortalUsers": {
      ".read": false,
      ".write": false
    },
    "clientPortalInvitationHashes": {
      ".read": false,
      ".write": false
    },

    "schedulerLocks": {
      ".read": false,
      ".write": false
    },

    "rateLimits": {
      ".read": false,
      ".write": false
    },

    "users": {
      ".read": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/)",
      ".write": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Super Admin')",
      ".indexOn": ["email", "managerId"]
    },

    "clients": {
      ".read": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/)",
      ".write": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Super Admin')"
    },

    "clientLogs": {
      ".read": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/)",
      "$clientId": {
        ".write": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/) && root.child('userRoles').child(auth.uid).val() !== null && root.child('userRoles').child(auth.uid).val() !== 'Client'"
      }
    },

    "config": {
      ".read": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/)",
      ".write": false
    },

    "settings": {
      ".read": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/)",
      ".write": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Super Admin')"
    },

    "taskCategories": {
      ".read": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && auth.token.email.matches(/.*@ethinos[.]com$/)",
      ".write": "auth != null && !root.child('clientPortalUsers').child(auth.uid).exists() && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Super Admin')"
    }
  }
}
